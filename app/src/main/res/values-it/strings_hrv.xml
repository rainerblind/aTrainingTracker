    <string name="tuning_dfa_a1_t1_title">Soglia aerobica DFA a1 (T1)</string>
    <string name="tuning_dfa_a1_t1_desc">Soglia che separa la base aerobica (Zona 2) dalla transizione (Zona 3). Più alto = più frattale / aerobico.</string>
    <string name="tuning_dfa_a1_t2_title">Soglia anaerobica DFA a1 (T2)</string>
    <string name="tuning_dfa_a1_t2_desc">Soglia che separa la transizione (Zona 3) dall\'intensità anaerobica (Zona 4). Più alto = più frattale / aerobico.</string>
    <string name="tuning_dfa_a1_default">Predefinito: %1$.2f (Invariante: T1 \u2265 T2 + 0.05)</string>
