    <!-- Specialized Altitude Devices Explanations (ATT-5073, REQ-SEN-026) -->
    <string name="device_altitude_explanation_title">Informazioni su questo sensore</string>
    <string name="device_altitude_how_it_works_header">Come funziona</string>
    <string name="device_altitude_pros_cons_header">Pro e contro</string>
    <string name="device_altitude_pressure_how_it_works">Misura la pressione atmosferica con il barometro interno. Calcola i cambi di quota relativi tramite la formula barometrica, calibrata nei luoghi noti o manualmente.</string>
    <string name="device_altitude_pressure_pros_cons">+ Molto reattivo e fluido; nessun disturbo verticale GPS; funziona nei tunnel.\n- Il meteo può causare derive di quota nel corso del tempo.</string>
    <string name="device_altitude_position_how_it_works">Confronta la posizione GPS con modelli digitali di elevazione (DEM) memorizzati o scaricati da Open-Meteo.</string>
    <string name="device_altitude_position_pros_cons">+ Immune a meteo e derive barometriche; quota assoluta senza calibrazione.\n- Richiede connessione Internet attiva per aree non memorizzate nella cache; dipende dalla precisione GPS (a scalini su ponti e pareti scoscese).</string>

    <!-- ATT Odometry Fusion Device Configuration (ATT-7751, REQ-SEN-028) -->
    <string name="device_att_fused_sources_header">Sorgenti dati</string>
    <string name="device_att_fused_how_it_works">Unisce posizioni GNSS, giri ruota calibrati e rotazioni giroscopiche 3D in un filtro di Kalman esteso (EKF) a 5 stati con stima della posizione continua.</string>
    <string name="device_att_fused_pros_cons">+ Tracciamento ininterrotto in gallerie e boschi densi; precisione sub-metrica; esclusione anomalie.\n- Maggiore consumo di batteria per il campionamento continuo del giroscopio.</string>
    <string name="device_att_fused_toggle_gnss">Usa posizioni GNSS</string>
    <string name="device_att_fused_toggle_gnss_hint_disabled">Autorizzazione posizione richiesta</string>
    <string name="device_att_fused_toggle_wheel">Usa sensori velocità ruota</string>
    <string name="device_att_fused_toggle_wheel_hint_disabled">Nessun sensore ruota abbinato</string>
    <string name="device_att_fused_toggle_gyro">Usa IMU giroscopio</string>
    <string name="device_att_fused_toggle_gyro_hint_disabled">Giroscopio non rilevato sullo smartphone</string>
    <string name="device_att_fused_toggle_autocalib">Calibrazione automatica ruota continua</string>
    <string name="device_att_fused_toggle_autocalib_hint_disabled">Richiede sensore ruota e GNSS</string>

    <!-- ATT Altitude & Slope Fusion Device Configuration (ATT-6279, REQ-FIL-016) -->
    <string name="device_att_fused_alt_how_it_works">Accoppia direttamente le variazioni di quota all\'avanzamento orizzontale (dh = g * ds) con blocco da fermo e fusione Kalman senza deriva tra barometro e DEM/GPS.</string>
    <string name="device_att_fused_alt_pros_cons">+ Evita dislivello fantasma da fermi e gradini DEM; pendenza molto reattiva.\n- Richiede barometro o sensore di quota attivo.</string>
    <string name="device_att_fused_alt_toggle_baro">Altitudine barometrica (Barometro)</string>
    <string name="device_att_fused_alt_toggle_baro_hint_disabled">Nessun sensore barometrico associato o disponibile</string>
    <string name="device_att_fused_alt_toggle_dem">Altitudine topografica (DEM)</string>
    <string name="device_att_fused_alt_toggle_dem_hint_disabled">Altitudine topografica (DEM) non associata</string>
    <string name="device_att_fused_alt_toggle_gps">Altitudine GPS (Correzione deriva a lungo termine)</string>
    <string name="device_att_fused_alt_toggle_gps_hint_disabled">Nessun sensore di posizione o GPS associato</string>
    <string name="device_att_fused_alt_toggle_speed">Accoppiamento velocità (Blocco da fermo &amp; dh = g * ds)</string>
    <string name="device_att_fused_alt_toggle_speed_hint_disabled">Nessun sensore di velocità o movimento disponibile</string>

