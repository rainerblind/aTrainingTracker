    <!-- Specialized Altitude Devices Explanations (ATT-5073, REQ-SEN-026) -->
    <string name="device_altitude_explanation_title">O tym czujniku</string>
    <string name="device_altitude_how_it_works_header">Jak to działa</string>
    <string name="device_altitude_pros_cons_header">Zalety i wady</string>
    <string name="device_altitude_pressure_how_it_works">Mierzy ciśnienie powietrza wbudowanym barometrem. Oblicza względne zmiany wysokości ze wzoru barometrycznego, kalibrowana w ulubionych miejscach lub ręcznie.</string>
    <string name="device_altitude_pressure_pros_cons">+ Płynna i czuła; brak szumów pionowych GPS; działa w tunelach.\n- Zmiany pogody mogą powodować dryf wysokości w czasie.</string>
    <string name="device_altitude_position_how_it_works">Porównuje pozycję GPS z cyfrowymi modelami terenu (DEM) z pamięci podręcznej lub z Open-Meteo.</string>
    <string name="device_altitude_position_pros_cons">+ Niewrażliwa na pogodę i dryf ciśnienia; bezwzględna wysokość bez kalibracji.\n- Wymaga aktywnego połączenia z internetem w niebuforowanych obszarach; zależy od dokładności GPS (schodkowa na mostach i urwiskach).</string>

    <!-- ATT Odometry Fusion Device Configuration (ATT-7751, REQ-SEN-028) -->
    <string name="device_att_fused_how_it_works">Łączy pozycje GNSS, skalibrowane obroty koła i obroty żyroskopu 3D w 5-stanowy rozszerzony filtr Kalmana (EKF) z ciągłą nawigacją zliczeniową.</string>
    <string name="device_att_fused_pros_cons">+ Płynne śledzenie w tunelach i gęstym lesie; precyzja submetrowa; odrzucanie błędnych pomiarów.\n- Większe zużycie baterii przez ciągłe próbkowanie żyroskopu.</string>
    <string name="device_att_fused_toggle_gnss">Użyj pozycji GNSS</string>
    <string name="device_att_fused_toggle_gnss_hint_disabled">Wymagane uprawnienie do lokalizacji</string>
    <string name="device_att_fused_toggle_wheel">Użyj czujników prędkości koła</string>
    <string name="device_att_fused_toggle_wheel_hint_disabled">Brak sparowanego czujnika koła</string>
    <string name="device_att_fused_toggle_gyro">Użyj IMU żyroskopu</string>
    <string name="device_att_fused_toggle_gyro_hint_disabled">Brak wbudowanego żyroskopu</string>
    <string name="device_att_fused_toggle_autocalib">Ciągła autokalibracja koła</string>
    <string name="device_att_fused_toggle_autocalib_hint_disabled">Wymaga czujnika koła i GNSS</string>

    <!-- ATT Altitude & Slope Fusion Device Configuration (ATT-6279, REQ-FIL-016) -->
    <string name="device_att_fused_alt_how_it_works">Wiąże zmiany wysokości bezpośrednio z postępem poziomym (dh = g * ds) z blokadą podczas postoju i bezdryfową fuzją Kalmana barometru i DEM/GPS.</string>
    <string name="device_att_fused_alt_pros_cons">+ Zapobiega fałszywym przewyższeniom na postoju i schodkowaniu DEM; bardzo czułe nachylenie.\n- Wymaga aktywnego barometru lub czujnika wysokości.</string>
    <string name="device_att_fused_alt_toggle_baro">Wysokość barometryczna (Barometr)</string>
    <string name="device_att_fused_alt_toggle_baro_hint_disabled">Brak sparowanego lub dostępnego czujnika barometru</string>
    <string name="device_att_fused_alt_toggle_dem">Wysokość topograficzna (DEM)</string>
    <string name="device_att_fused_alt_toggle_dem_hint_disabled">Wysokość topograficzna (DEM) nie jest sparowana</string>
    <string name="device_att_fused_alt_toggle_gps">Wysokość GPS (Długoterminowa korekcja dryfu)</string>
    <string name="device_att_fused_alt_toggle_gps_hint_disabled">Brak sparowanego czujnika lokalizacji lub GPS</string>
    <string name="device_att_fused_alt_toggle_speed">Sprzężenie z prędkością (Blokada postoju &amp; dh = g * ds)</string>
    <string name="device_att_fused_alt_toggle_speed_hint_disabled">Brak dostępnego czujnika prędkości lub ruchu</string>

