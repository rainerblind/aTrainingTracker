    <string name="polar_h10_retry_sync_dismiss">Odrzuć</string>
    <string name="polar_h10_retry_syncing">Synchronizowanie Polar H10…</string>
    <string name="polar_h10_retry_sync_failed">Nie udało się połączyć z Polar H10. Wybudź czujnik i spróbuj ponownie.</string>
    <string name="polar_h10_retry_sync_unpaired_hint">Polar H10 nie jest obecnie sparowany. Najpierw sparuj czujnik w sekcji Urządzenia przed synchronizacją.</string>

