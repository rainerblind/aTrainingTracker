<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="24dp"
        android:height="24dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <item
        android:drawable="@drawable/ic_directions_bike"
        android:width="14dp"
        android:height="14dp"
        android:gravity="top|left" />

    <item
        android:drawable="@drawable/ic_directions_run"
        android:width="14dp"
        android:height="14dp"
        android:gravity="bottom|right" />
</layer-list>