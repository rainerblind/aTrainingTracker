    <!-- Specialized Altitude Devices Explanations (ATT-5073, REQ-SEN-026) -->
    <string name="device_altitude_explanation_title">このセンサーについて</string>
    <string name="device_altitude_how_it_works_header">仕組み</string>
    <string name="device_altitude_pros_cons_header">メリットとデメリット</string>
    <string name="device_altitude_pressure_how_it_works">内蔵気圧計で大気圧を測定します。気圧計算式で相対的な高度変化を算出し、お気に入りの場所や手動で校正されます。</string>
    <string name="device_altitude_pressure_pros_cons">+ 非常に高精度で滑らか、GPSの垂直ノイズなし、トンネル内でも機能。\n- 天候変化により時間経過で高度のドリフトが生じることがあります。</string>
    <string name="device_altitude_position_how_it_works">GPS位置を保存されたルートのキャッシュまたはOpen-Meteoの標高モデル(DEM)と照合します。</string>
    <string name="device_altitude_position_pros_cons">+ 天候や気圧ドリフトに影響されず、校正不要で正確な絶対標高を提供。\n- 未キャッシュ地域ではアクティブなインターネット接続が必要；GPS精度に依存し、橋や急崖などでは誤差が生じる場合があります。</string>

    <!-- ATT Odometry Fusion Device Configuration (ATT-7751, REQ-SEN-028) -->
    <string name="device_att_fused_how_it_works">GNSS位置情報、校正済みホイール回転、3Dジャイロの回転を5状態拡張カルマンフィルター（EKF）で統合し、高精度な推測航法を提供します。</string>
    <string name="device_att_fused_pros_cons">+ トンネルや森林でも途切れないトラッキング、サブメートル精度、外れ値の除去。\n- ジャイロセンサーの常時動作によるバッテリー消費の増加。</string>
    <string name="device_att_fused_toggle_gnss">GNSS位置情報を使用</string>
    <string name="device_att_fused_toggle_gnss_hint_disabled">位置情報の権限が必要です</string>
    <string name="device_att_fused_toggle_wheel">スピードセンサーを使用</string>
    <string name="device_att_fused_toggle_wheel_hint_disabled">ペアリングされたホイールセンサーがありません</string>
    <string name="device_att_fused_toggle_gyro">ジャイロIMUを使用</string>
    <string name="device_att_fused_toggle_gyro_hint_disabled">ジャイロセンサーが検出されません</string>
    <string name="device_att_fused_toggle_autocalib">ホイール周長の自動校正</string>
    <string name="device_att_fused_toggle_autocalib_hint_disabled">ホイールセンサーとGNSSが必要です</string>

    <!-- ATT Altitude & Slope Fusion Device Configuration (ATT-6279, REQ-FIL-016) -->
    <string name="device_att_fused_alt_how_it_works">気圧計とDEM/GPSのドリフトフリーなカルマン融合と停止時クランプにより、高度変化を水平移動に直接連動(dh = g * ds)させます。</string>
    <string name="device_att_fused_alt_pros_cons">+ 停止中の不要な獲得標高やDEMの階段状変化を防止。俊敏な勾配反応。\n- 有効な気圧計または高度センサーが必要。</string>
    <string name="device_att_fused_alt_toggle_baro">気圧高度 (気圧計)</string>
    <string name="device_att_fused_alt_toggle_baro_hint_disabled">気圧計センサーがペアリングされていないか利用できません</string>
    <string name="device_att_fused_alt_toggle_dem">地形高度 (DEM)</string>
    <string name="device_att_fused_alt_toggle_dem_hint_disabled">地形高度 (DEM) がペアリングされていません</string>
    <string name="device_att_fused_alt_toggle_gps">GPS高度 (長期ドリフト補正)</string>
    <string name="device_att_fused_alt_toggle_gps_hint_disabled">位置情報またはGPSセンサーがペアリングされていません</string>
    <string name="device_att_fused_alt_toggle_speed">速度連動 (停止時クランプ &amp; dh = g * ds)</string>
    <string name="device_att_fused_alt_toggle_speed_hint_disabled">利用可能な速度または運動センサーがありません</string>

