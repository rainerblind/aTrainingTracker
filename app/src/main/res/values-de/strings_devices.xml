    <!-- Specialized Altitude Devices Explanations (ATT-5073, REQ-SEN-026) -->
    <string name="device_altitude_explanation_title">Über diesen Sensor</string>
    <string name="device_altitude_how_it_works_header">Funktionsweise</string>
    <string name="device_altitude_pros_cons_header">Vor- &amp; Nachteile</string>
    <string name="device_altitude_pressure_how_it_works">Misst den Luftdruck mit dem internen Barometer. Berechnet relative Höhenänderungen über die barometrische Höhenformel, kalibriert an Lieblingsorten oder manuell.</string>
    <string name="device_altitude_pressure_pros_cons">+ Sehr reaktionsschnell und glatt; kein GPS-Höhenflattern; funktioniert in Tunnels.\n- Wetterwechsel können im Zeitverlauf zu Höhendrift führen.</string>
    <string name="device_altitude_position_how_it_works">Gleicht Ihre GPS-Position mit digitalen Geländemodellen (DEM) ab, die aus Strecken zwischengespeichert oder von Open-Meteo geladen werden.</string>
    <string name="device_altitude_position_pros_cons">+ Wetterunabhängig und ohne Barometerdrift; absolute Höhe ohne Kalibrierung.\n- Erfordert aktive Internetverbindung für ungecachte Gebiete; abhängig von GPS-Genauigkeit, auf Brücken und Steilhängen ungenauer.</string>

    <!-- ATT Odometry Fusion Device Configuration (ATT-7751, REQ-SEN-028) -->
    <string name="device_att_fused_how_it_works">Fusioniert GNSS-Positionen, kalibrierte Radumdrehungen und 3D-Gyroskopdrehungen in einem kontinuierlichen 5-Zustands-Unicycle-Extended-Kalman-Filter (EKF) mit Koppelnavigation im Subsekundentakt.</string>
    <string name="device_att_fused_pros_cons">+ Lückenlose Aufzeichnung in Tunnels und dichtem Wald; Submeter-Präzision; Ausreißerunterdrückung.\n- Höherer Akkuverbrauch durch kontinuierliche Abtastung des Smartphone-Gyroskops.</string>
    <string name="device_att_fused_toggle_gnss">GNSS-Positionen nutzen</string>
    <string name="device_att_fused_toggle_gnss_hint_disabled">Standortberechtigung muss erteilt sein</string>
    <string name="device_att_fused_toggle_wheel">Geschwindigkeitssensoren nutzen</string>
    <string name="device_att_fused_toggle_wheel_hint_disabled">Kein gekoppelter Radsensor verfügbar</string>
    <string name="device_att_fused_toggle_gyro">Gyroskop-IMU nutzen</string>
    <string name="device_att_fused_toggle_gyro_hint_disabled">Kein Smartphone-Gyroskop vorhanden</string>
    <string name="device_att_fused_toggle_autocalib">Kontinuierliche Rad-Autokalibrierung</string>
    <string name="device_att_fused_toggle_autocalib_hint_disabled">Erfordert Radsensor und GNSS</string>

    <!-- ATT Altitude & Slope Fusion Device Configuration (ATT-6279, REQ-FIL-016) -->
    <string name="device_att_fused_alt_how_it_works">Koppelt Höhenänderungen kontinuierlich an den horizontalen Weg (dh = g * ds) mit Stillstands-Fixierung und driftfreier Kalman-Fusion aus Barometer und DEM/GPS.</string>
    <string name="device_att_fused_alt_pros_cons">+ Verhindert Schein-Höhenmeter im Stand und DEM-Treppenstufen; sehr reaktionsschnelle Steigung.\n- Erfordert aktiven Barometer- oder Höhensensor.</string>
    <string name="device_att_fused_alt_toggle_baro">Höhe aus Luftdruck (Barometer)</string>
    <string name="device_att_fused_alt_toggle_baro_hint_disabled">Kein Barometer-Sensor gekoppelt oder vorhanden</string>
    <string name="device_att_fused_alt_toggle_dem">Topografische Höhe (DEM)</string>
    <string name="device_att_fused_alt_toggle_dem_hint_disabled">Topografische Höhe (DEM) nicht gekoppelt</string>
    <string name="device_att_fused_alt_toggle_gps">GPS-Höhe (Langzeit-Driftkorrektur)</string>
    <string name="device_att_fused_alt_toggle_gps_hint_disabled">Kein Standort- oder GPS-Sensor gekoppelt</string>
    <string name="device_att_fused_alt_toggle_speed">Geschwindigkeits-Kopplung (Stillstands-Fix &amp; dh = g * ds)</string>
    <string name="device_att_fused_alt_toggle_speed_hint_disabled">Kein Geschwindigkeits- oder Bewegungssensor verfügbar</string>

