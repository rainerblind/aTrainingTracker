    <!-- Specialized Altitude Devices Explanations (ATT-5073, REQ-SEN-026) -->
    <string name="device_altitude_explanation_title">Over deze sensor</string>
    <string name="device_altitude_how_it_works_header">Hoe het werkt</string>
    <string name="device_altitude_pros_cons_header">Voor- &amp; nadelen</string>
    <string name="device_altitude_pressure_how_it_works">Meet de luchtdruk via de interne barometer. Berekent relatieve hoogteverschillen via de barometrische formule, automatisch gekalibreerd bij bekende locaties of handmatig.</string>
    <string name="device_altitude_pressure_pros_cons">+ Zeer responsief en stabiel; geen verticale GPS-ruis; werkt in tunnels.\n- Weersveranderingen kunnen na verloop van tijd voor hoogtedrift zorgen.</string>
    <string name="device_altitude_position_how_it_works">Koppelt uw GPS-positie aan digitale hoogtemodellen (DEM) uit routecaches of van Open-Meteo.</string>
    <string name="device_altitude_position_pros_cons">+ Immuun voor weer en barometrische drift; absolute hoogte zonder kalibratie.\n- Vereist actieve internetverbinding voor niet-gecachte gebieden; afhankelijk van GPS-nauwkeurigheid (kan verspringen op bruggen en kliffen).</string>

