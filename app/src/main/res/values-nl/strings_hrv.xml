    <string name="morning_hrv_artifact_warning_title">Hoog artefactpercentage</string>
    <string name="morning_hrv_artifact_warning_desc">Artefactpercentage overschrijdt 5%% (%1$.1f%%). Bevochtig de elektroden van de borstband en controleer de pasvorm.</string>
    <string name="morning_hrv_smoothed_warning_title">Afgevlakte RR-stroom gedetecteerd</string>
    <string name="morning_hrv_smoothed_warning_desc">Er is firmware-afvlakking gedetecteerd op deze sensor. Beat-to-beat variantie wordt kunstmatig onderdrukt (rMSSD is kunstmatig laag). We raden aan deze meting niet op te slaan om je herstelbasislijn niet te verstoren.</string>
