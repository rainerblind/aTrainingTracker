    <!-- Specialized Altitude Devices Explanations (ATT-5073, REQ-SEN-026) -->
    <string name="device_altitude_explanation_title">À propos de ce capteur</string>
    <string name="device_altitude_how_it_works_header">Fonctionnement</string>
    <string name="device_altitude_pros_cons_header">Avantages et inconvénients</string>
    <string name="device_altitude_pressure_how_it_works">Mesure la pression atmosphérique avec le baromètre interne. Calcule les variations d\'altitude relatives via la formule barométrique, calibrée aux lieux connus ou manuellement.</string>
    <string name="device_altitude_pressure_pros_cons">+ Très réactif et fluide ; sans bruit vertical GPS ; fonctionne en tunnel.\n- La météo peut entraîner une dérive d\'altitude au fil du temps.</string>
    <string name="device_altitude_position_how_it_works">Associe votre position GPS à des modèles numériques de terrain (MNT) en cache ou en ligne via Open-Meteo.</string>
    <string name="device_altitude_position_pros_cons">+ Insensible à la météo et aux dérives ; altitude absolue sans calibrage.\n- Nécessite une connexion Internet active pour les zones non mises en cache ; dépend de la précision GPS (moins précis sur ponts et falaises).</string>

    <!-- ATT Odometry Fusion Device Configuration (ATT-7751, REQ-SEN-028) -->
    <string name="device_att_fused_how_it_works">Fusionne les positions GNSS, les tours de roue calibrés et les rotations gyroscopiques 3D dans un filtre de Kalman étendu (EKF) à 5 états avec navigation à l\'estime continue.</string>
    <string name="device_att_fused_pros_cons">+ Suivi ininterrompu dans les tunnels et sous couvert forestier; précision métrique; rejet des valeurs aberrantes.\n- Consommation de batterie accrue due à l\'échantillonnage continu du gyroscope.</string>
    <string name="device_att_fused_toggle_gnss">Utiliser les positions GNSS</string>
    <string name="device_att_fused_toggle_gnss_hint_disabled">Autorisation de localisation requise</string>
    <string name="device_att_fused_toggle_wheel">Utiliser les capteurs de vitesse de roue</string>
    <string name="device_att_fused_toggle_wheel_hint_disabled">Aucun capteur de roue appairé disponible</string>
    <string name="device_att_fused_toggle_gyro">Utiliser l\'IMU gyroscopique</string>
    <string name="device_att_fused_toggle_gyro_hint_disabled">Aucun gyroscope détecté sur le téléphone</string>
    <string name="device_att_fused_toggle_autocalib">Auto-étalonnage continu de la roue</string>
    <string name="device_att_fused_toggle_autocalib_hint_disabled">Nécessite un capteur de roue et le GNSS</string>

    <!-- ATT Altitude & Slope Fusion Device Configuration (ATT-6279, REQ-FIL-016) -->
    <string name="device_att_fused_alt_how_it_works">Associe directement les changements d\'altitude à la progression horizontale (dh = g * ds) avec verrouillage à l\'arrêt et fusion de Kalman sans dérive entre baromètre et MNT/GPS.</string>
    <string name="device_att_fused_alt_pros_cons">+ Empêche le dénivelé fantôme à l\'arrêt et les marches d\'escalier du MNT; pente très réactive.\n- Nécessite un baromètre ou capteur d\'altitude actif.</string>
    <string name="device_att_fused_alt_toggle_baro">Altitude barométrique (Baromètre)</string>
    <string name="device_att_fused_alt_toggle_baro_hint_disabled">Aucun capteur barométrique appairé ou disponible</string>
    <string name="device_att_fused_alt_toggle_dem">Altitude topographique (MNT)</string>
    <string name="device_att_fused_alt_toggle_dem_hint_disabled">Altitude topographique (MNT) non appairée</string>
    <string name="device_att_fused_alt_toggle_gps">Altitude GPS (Correction de dérive à long terme)</string>
    <string name="device_att_fused_alt_toggle_gps_hint_disabled">Aucun capteur de position ou GPS appairé</string>
    <string name="device_att_fused_alt_toggle_speed">Couplage de vitesse (Fixe à l\'arrêt &amp; dh = g * ds)</string>
    <string name="device_att_fused_alt_toggle_speed_hint_disabled">Aucun capteur de vitesse ou de mouvement disponible</string>

