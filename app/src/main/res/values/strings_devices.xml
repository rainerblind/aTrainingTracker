    <!-- Specialized Altitude Devices Explanations (ATT-5073, REQ-SEN-026) -->
    <string name="device_altitude_explanation_title">About this Sensor</string>
    <string name="device_altitude_how_it_works_header">How it works</string>
    <string name="device_altitude_pros_cons_header">Pros &amp; Cons</string>
    <string name="device_altitude_pressure_how_it_works">Measures atmospheric air pressure using the internal barometer. Calculates relative elevation changes via the barometric formula, calibrated automatically at known locations or manually.</string>
    <string name="device_altitude_pressure_pros_cons">+ Very responsive and smooth; zero GPS vertical jitter; works indoors and in tunnels.\n- Weather and atmospheric pressure changes can cause altitude drift over time.</string>
    <string name="device_altitude_position_how_it_works">Matches your GPS position against digital elevation models (DEM) cached locally from saved routes or fetched online from Open-Meteo.</string>
    <string name="device_altitude_position_pros_cons">+ Immune to weather and barometric drift; accurate absolute height without calibration.\n- Requires active internet connection for uncached areas; depends on GPS accuracy and can be stepped on bridges or cliffs.</string>

    <!-- ATT Odometry Fusion Device Configuration (ATT-7751, REQ-SEN-028) -->
    <string name="device_att_fused_how_it_works">Fuses GNSS position fixes, calibrated wheel revolutions, and 3D gyroscope turns into a continuous 5-state unicycle Extended Kalman Filter (EKF) with sub-second dead reckoning.</string>
    <string name="device_att_fused_pros_cons">+ Uninterrupted tracking through tunnels and dense forest canopy; sub-meter precision; outlier rejection.\n- Increased battery consumption from continuous phone gyroscope sampling.</string>
    <string name="device_att_fused_toggle_gnss">Use GNSS Positions</string>
    <string name="device_att_fused_toggle_gnss_hint_disabled">Requires location permission to be granted</string>
    <string name="device_att_fused_toggle_wheel">Use Wheel Speed Sensors</string>
    <string name="device_att_fused_toggle_wheel_hint_disabled">No paired wheel speed sensor available</string>
    <string name="device_att_fused_toggle_gyro">Use Gyroscope IMU</string>
    <string name="device_att_fused_toggle_gyro_hint_disabled">No phone gyroscope hardware detected</string>
    <string name="device_att_fused_toggle_autocalib">Continuous Wheel Auto-Calibration</string>
    <string name="device_att_fused_toggle_autocalib_hint_disabled">Requires wheel speed sensor and GNSS</string>

    <!-- ATT Altitude & Slope Fusion Device Configuration (ATT-6279, REQ-FIL-016) -->
    <string name="device_att_fused_alt_how_it_works">Couples vertical elevation changes directly to horizontal progress (dh = g * ds) with standstill altitude clamping and drift-free Kalman fusion of barometer and DEM/GPS.</string>
    <string name="device_att_fused_alt_pros_cons">+ Prevents phantom elevation gain during standstills and DEM staircase steps; highly responsive slope.\n- Requires active barometer or altitude sensor.</string>
    <string name="device_att_fused_alt_toggle_baro">Barometric Altitude (Barometer)</string>
    <string name="device_att_fused_alt_toggle_baro_hint_disabled">No barometer sensor paired or available</string>
    <string name="device_att_fused_alt_toggle_dem">Topographic Altitude (DEM)</string>
    <string name="device_att_fused_alt_toggle_dem_hint_disabled">Topographic altitude (DEM) not paired</string>
    <string name="device_att_fused_alt_toggle_gps">GPS Altitude (Long-Term Drift Correction)</string>
    <string name="device_att_fused_alt_toggle_gps_hint_disabled">No location or GPS sensor paired</string>
    <string name="device_att_fused_alt_toggle_speed">Speed Coupling (Standstill Clamp &amp; dh = g * ds)</string>
    <string name="device_att_fused_alt_toggle_speed_hint_disabled">No speed or motion sensor available</string>

