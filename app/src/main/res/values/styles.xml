<resources xmlns:tools="http://schemas.android.com/tools">

    <!--Components-->

    <!--Bottom Sheets-->
    <style name="ThemeOverlay.aTrainingTracker.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Animation.MyTheme.BottomSheet.Modal</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/Widget.aTrainingTracker.BottomSheet.Modal</item>
    </style>
    <style name="Widget.aTrainingTracker.BottomSheet.Modal" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">?shapeAppearanceLargeComponent</item>
    </style>

    <style name="Widget.aTrainingTracker.Toolbar.ToolBarStyle" parent="Widget.AppCompat.Toolbar">
        <item name="titleTextColor">@color/my_white</item>
        <item name="colorControlNormal">@color/my_white</item>
    </style>

</resources>
