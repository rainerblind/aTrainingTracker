# Jira URL (e.g. https://your-domain.atlassian.net or https://jira.internal.corp/jira)
JIRA_URL=https://your-domain.atlassian.net

# Deployment type: "cloud" (default) or "datacenter" (Jira Data Center / Server)
# JIRA_DEPLOYMENT=cloud

# Optional authentication type override: "basic" or "bearer" (default: basic for Cloud, bearer for Data Center PAT)
# JIRA_AUTH_TYPE=basic

# Optional corporate CA bundle and TLS verification for on-premise Jira Data Center
# JIRA_CA_BUNDLE=/path/to/corporate-ca-bundle.crt
# JIRA_SSL_VERIFY=true

# Optional custom field ID for Epic Link in Jira Data Center (default: customfield_10014)
# JIRA_EPIC_LINK_FIELD=customfield_10014

# Role-specific authentication for strict ASPICE separation of concerns:
# Agent 1 (Implementer): Authors deliverables, implements code, submits stages
JIRA_AGENT1_USER=agent1@example.com
JIRA_AGENT1_TOKEN=your_agent1_api_token_here
JIRA_AGENT1_ACCOUNT_ID=712020:agent1-uuid-here

# Agent 2 (Auditor): Audits deliverables, issues gate verdicts (gate-verdict PASS/REVISION)
JIRA_AGENT2_USER=agent2@example.com
JIRA_AGENT2_TOKEN=your_agent2_api_token_here
JIRA_AGENT2_ACCOUNT_ID=712020:agent2-uuid-here

# Coordinator: Sprint backlog queries, subtask orchestration, ceremony facilitation
JIRA_COORDINATOR_USER=coordinator@example.com
JIRA_COORDINATOR_TOKEN=your_coordinator_api_token_here
JIRA_COORDINATOR_ACCOUNT_ID=712020:coordinator-uuid-here

# Human Gatekeeper: Account ID of the human engineer with exclusive authority to close parent tickets
JIRA_HUMAN_ACCOUNT_ID=712020:human-uuid-here
